# --- ClaimOS gitignore ---

# Environment files and secrets — never commit real credentials
# (explicit patterns; a wildcard like *.env.* would also hide the tracked
# .env.example templates and force contributors to git add -f)
.env
.env.local
.env.*.local
backend/.env*
!backend/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Uploaded and generated data (claim evidence, PDFs, local storage)
uploads/

# Node / frontend builds
node_modules/
dist/
build/
coverage/
.eslintcache
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local databases
*.sqlite3
dump.rdb

# OS and editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
