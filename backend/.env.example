# ClaimOS backend environment template.
# Copy to backend/.env and adjust for your machine. Never commit real secrets.

# MongoDB connection string (required — the database module reads it at import).
# Local development default:
MONGO_URL=mongodb://127.0.0.1:27017
# Managed (Atlas) example:
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Database name (required)
DB_NAME=claimos

# Comma-separated list of allowed CORS origins for the API (optional; defaults to *).
# Use an explicit allowlist in any shared or deployed environment, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
CORS_ORIGINS=*

# Anthropic API key for the five-agent pipeline's LLM adapter (backend/app/llm/adapter.py).
# Optional at boot: the first real LLM call fails closed with a clear error if
# this is unset or empty.
ANTHROPIC_API_KEY=

# LLM call tuning (optional — adapter defaults: 3 retries, 60s timeout).
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_S=60

# ---- Auth (required in any deployed environment) ----
# HS256 secret for access tokens. REQUIRED when ENVIRONMENT=production (boot
# fails otherwise). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Access token TTL in minutes (default 15) / refresh token TTL in days (default 7).
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# Invite-only registration: the exact code /api/auth/register requires. Empty
# (default) disables registration entirely.
INVITE_CODE=
# Demo accounts seeded at startup for development. Empty email/password skips
# that role — no default credentials are shipped.
DEMO_ADJUSTER_EMAIL=
DEMO_ADJUSTER_PASSWORD=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# Force the Secure flag on refresh/CSRF cookies (auto-enabled outside development).
# COOKIE_SECURE=true
# Rate limits per client IP (slowapi syntax).
# LOGIN_RATE_LIMIT=5/minute
# FNOL_RATE_LIMIT=10/minute
